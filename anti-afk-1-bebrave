-- Anti-AFK for Steal an Egg (or any Roblox game)
-- Requires: an executor (Delta, Xeno, Solara, etc.)

local UIS = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")

-- Settings
local pressW = true
local pressD = true
local pressMouse = true
local isRunning = false
local interval = 60 -- seconds

-- Key press helper
local function pressKey(keyCode)
    UIS:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.1)
    UIS:SendKeyEvent(false, keyCode, false, game)
end

-- Mouse click helper
local function clickMouse()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
    -- Alternative for LMB at center:
    -- VirtualUser:ClickButton1(Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y/2))
end

-- Anti-AFK loop
local function afkLoop()
    while isRunning do
        if pressW then pressKey(Enum.KeyCode.W) end
        if pressD then pressKey(Enum.KeyCode.D) end
        if pressMouse then clickMouse() end
        task.wait(interval)
    end
end

