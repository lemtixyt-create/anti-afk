-- Checkboxes
local function makeCheckbox(name, label, yPos, defaultChecked)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    btn.Text = (defaultChecked and "☑ " or "☐ ") .. label
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.Size = UDim2.new(0.4, 0, 0, 28)
    btn.Position = UDim2.new(yPos == 1 and 0.08 or 0.52, 0, 0.45, 0)
    btn.BorderSizePixel = 0
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    return btn
end

local chkW = makeCheckbox("ChkW", "Press W", 1, true)
local chkD = makeCheckbox("ChkD", "Press D", 2, true)
local chkMouse = makeCheckbox("ChkMouse", "LMB Click", 3, true)

-- Row 2 for mouse checkbox (centered)
chkMouse.Position = UDim2.new(0.08, 0, 0.57, 0)
chkMouse.Size = UDim2.new(0.8, 0, 0, 28)

-- Checkbox logic
local function connectCheck(btn, varName)
    btn.MouseButton1Click:Connect(function()
        if varName == "W" then pressW = not pressW
        elseif varName == "D" then pressD = not pressD
        elseif varName == "Mouse" then pressMouse = not pressMouse
        end
        local labels = {W = "Press W", D = "Press D", Mouse = "LMB Click"}
        local val = (varName == "W" and pressW) or (varName == "D" and pressD) or (varName == "Mouse" and pressMouse)
        btn.Text = (val and "☑ " or "☐ ") .. labels[varName]
        btn.BackgroundColor3 = val and Color3.fromRGB(0, 120, 80) or Color3.fromRGB(35, 35, 50)
    end)
end

connectCheck(chkW, "W")
connectCheck(chkD, "D")
connectCheck(chkMouse, "Mouse")

-- Toggle logic
ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleBtn.Text = "DISABLE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        Status.Text = "Status: ON"
        Status.TextColor3 = Color3.fromRGB(0, 255, 100)
        task.spawn(afkLoop)
    else
        ToggleBtn.Text = "ENABLE"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 120)
        Status.Text = "Status: OFF"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Drag
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)
UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input == dragInput then dragging = false end
end)

