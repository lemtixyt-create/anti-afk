-- Pulse dot animation
local function pulseDot(active)
    task.spawn(function()
        while antiAFKOn do
            makeTween(statusDot, {BackgroundTransparency = 0.4}, 0.5)
            task.wait(0.5)
            makeTween(statusDot, {BackgroundTransparency = 0}, 0.5)
            task.wait(0.5)
        end
        statusDot.BackgroundTransparency = 0
    end)
end

