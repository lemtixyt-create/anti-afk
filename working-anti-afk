-- Toggle logic
local function setToggle(state)
    antiAFKOn = state
    makeTween(togBtn, {
        BackgroundColor3 = state and Color3.fromHex("#7c3aed") or Color3.fromHex("#1e1e3a")
    }, 0.2)
    togBtnStroke.Color = state and Color3.fromHex("#7c3aed") or Color3.fromHex("#3a3a6a")
    makeTween(togThumb, {
        Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = state and Color3.fromHex("#ffffff") or Color3.fromHex("#6b7280")
    }, 0.2)
    makeTween(frameStroke, {Color = state and Color3.fromHex("#7c3aed") or Color3.fromHex("#3a3a6a")}, 0.3)

    if state then
        statusLbl.Text = "Active"
        statusLbl.TextColor3 = Color3.fromHex("#a78bfa")
        statusDot.BackgroundColor3 = Color3.fromHex("#7c3aed")
        nextFire = getNextInterval()
        timeLeft = nextFire
        pulseDot(true)

        -- Countdown ticker
        countdownConn = RunService.Heartbeat:Connect(function(dt)
            if not antiAFKOn then return end
            timeLeft = timeLeft - dt
            local secs = math.max(math.ceil(timeLeft), 0)
            local mins = math.floor(secs / 60)
            local s = secs % 60
            countdownLbl.Text = string.format("Next action: %d:%02d", mins, s)
            countdownLbl.TextColor3 = secs < 15
                and Color3.fromHex("#f87171")
                or Color3.fromHex("#4a4a6a")

            if timeLeft <= 0 then
                -- Fire the anti-AFK action
                timeLeft = getNextInterval()
                task.spawn(function()
                    flashCard()
                    doAntiAFK()
                    statusLbl.Text = "Fired ✓"
                    task.wait(1.5)
                    if antiAFKOn then statusLbl.Text = "Active" end
                end)
            end
        end)

    else
        if countdownConn then countdownConn:Disconnect(); countdownConn = nil end
        statusLbl.Text = "Inactive"
        statusLbl.TextColor3 = Color3.fromHex("#94a3b8")
        statusDot.BackgroundColor3 = Color3.fromHex("#6b7280")
        countdownLbl.Text = "Next: --"
        countdownLbl.TextColor3 = Color3.fromHex("#4a4a6a")
    end
end

