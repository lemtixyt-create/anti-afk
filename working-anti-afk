-- Organic press: hold for random short duration then release
local function pressKey(keyName)
    local holdTime = 0.08 + math.random() * 0.06 -- 80-140ms hold
    VIM:SendKeyEvent(true,  keyName, false, game)
    task.wait(holdTime)
    VIM:SendKeyEvent(false, keyName, false, game)
end

local function pressLMB()
    local holdTime = 0.06 + math.random() * 0.05
    VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 0)
    task.wait(holdTime)
    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Also ping VirtualUser to reset Roblox's own AFK timer
local function resetRobloxAFK()
    VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    task.wait(0.05)
    VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
end

local function doAntiAFK()
    -- Randomized order so it never looks the same twice
    local actions = {}
    if keyConfig.W   then table.insert(actions, function() pressKey("W") end) end
    if keyConfig.D   then table.insert(actions, function() pressKey("D") end) end
    if keyConfig.LMB then table.insert(actions, function() pressLMB() end) end

    -- Shuffle
    for i = #actions, 2, -1 do
        local j = math.random(1, i)
        actions[i], actions[j] = actions[j], actions[i]
    end

    -- Fire each with a tiny organic gap
    for _, action in ipairs(actions) do
        action()
        task.wait(0.05 + math.random() * 0.1)
    end

    -- Reset Roblox's native AFK detection
    resetRobloxAFK()
end

