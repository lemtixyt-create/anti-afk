local function makeCheckbox(parent, labelText, key, defaultOn)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundColor3 = Color3.fromHex("#13132b")
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)
    local rowStroke = Instance.new("UIStroke", row)
    rowStroke.Color = Color3.fromHex("#1e1e3a")
    rowStroke.Thickness = 1

    local rowPad = Instance.new("UIPadding", row)
    rowPad.PaddingLeft = UDim.new(0, 10)
    rowPad.PaddingRight = UDim.new(0, 10)

    local keyTag = Instance.new("TextLabel", row)
    keyTag.Text = labelText
    keyTag.Size = UDim2.new(0, 90, 1, 0)
    keyTag.BackgroundTransparency = 1
    keyTag.TextColor3 = Color3.fromHex("#c4b5fd")
    keyTag.TextSize = 11
    keyTag.Font = Enum.Font.GothamSemibold
    keyTag.TextXAlignment = Enum.TextXAlignment.Left

    local descLbl = Instance.new("TextLabel", row)
    descLbl.Text = key == "LMB" and "Left Click" or ("Key " .. key)
    descLbl.Size = UDim2.new(1, -130, 1, 0)
    descLbl.Position = UDim2.new(0, 90, 0, 0)
    descLbl.BackgroundTransparency = 1
    descLbl.TextColor3 = Color3.fromHex("#4a4a6a")
    descLbl.TextSize = 10
    descLbl.Font = Enum.Font.Gotham
    descLbl.TextXAlignment = Enum.TextXAlignment.Left

    -- Checkbox box
    local box = Instance.new("TextButton", row)
    box.Size = UDim2.new(0, 18, 0, 18)
    box.Position = UDim2.new(1, -18, 0.5, -9)
    box.BackgroundColor3 = defaultOn and Color3.fromHex("#7c3aed") or Color3.fromHex("#1e1e3a")
    box.BorderSizePixel = 0
    box.Text = defaultOn and "✓" or ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 10
    box.Font = Enum.Font.GothamBold
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    local boxStroke = Instance.new("UIStroke", box)
    boxStroke.Color = defaultOn and Color3.fromHex("#7c3aed") or Color3.fromHex("#3a3a6a")
    boxStroke.Thickness = 1.5

    local checked = defaultOn

    box.MouseButton1Click:Connect(function()
        checked = not checked
        keyConfig[key] = checked
        makeTween(box, {
            BackgroundColor3 = checked and Color3.fromHex("#7c3aed") or Color3.fromHex("#1e1e3a")
        }, 0.15)
        boxStroke.Color = checked and Color3.fromHex("#7c3aed") or Color3.fromHex("#3a3a6a")
        box.Text = checked and "✓" or ""
    end)

    checkboxRefs[key] = {box = box, checked = function() return checked end}
    return row
end

